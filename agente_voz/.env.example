# Plantilla para pruebas locales (FASE 3 del plan, con ngrok).
# Copiar a .env y llenar con valores reales -- .env NUNCA se sube (ver .gitignore).
# En producción (Cloud Run) estas variables llegan por --set-secrets, no por
# un archivo .env.

TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=+57XXXXXXXXXX

OPENAI_API_KEY=

# Contenido COMPLETO del JSON de la Service Account andrea-voz (todo en una
# línea). En local: gcloud secrets versions access latest --secret=andrea-sa-json
GOOGLE_SA_JSON=

# Contenido COMPLETO del guion (Robot Captador Fincaraiz/prompt_andrea.txt).
ANDREA_PROMPT=

# Calendario real (ya compartido con la Service Account andrea-voz@...).
GOOGLE_CALENDAR_ID=realestate.goldlifesystem@gmail.com

# Link fijo de Meet (respaldo) -- ver Secret Manager: andrea-meet-link-fijo.
MEET_LINK_FIJO=

# JSON {client_id, client_secret, refresh_token} para el link único de Meet
# por OAuth -- opcional, ver agente_voz_implementacion.md "Meet OAuth".
GOOGLE_OAUTH_MEET_JSON=

# La URL pública de ngrok mientras se prueba en local, ej: https://xxxx.ngrok.app
PUBLIC_BASE_URL=

# Opcionales -- tienen default razonable en config.py
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
ANALISIS_MODEL=gpt-4o-mini
MAX_LLAMADAS_POR_TANDA=10
MAX_LLAMADAS_CONCURRENTES=1
MAX_VISITAS_POR_DIA=4
DURACION_VISITA_MINUTOS=45
DURACION_MEET_MINUTOS=25
MAX_MEET_POR_DIA=4
POOL_LEADS_MAXIMO=1000
MINUTOS_ANTICIPACION_SEGUIMIENTO=15
TIMEOUT_LLAMADA_SEGUNDOS=900
