# ==========================================================
# .gitignore - Real Estate / Gold Life System
#
# ATENCION: guarda este archivo SIEMPRE en UTF-8 o ASCII, nunca en UTF-16.
# Una version anterior tenia varias lineas en UTF-16; git no pudo leerlas y
# de una de ellas dedujo una regla "*" que ignoraba TODO el repositorio en
# silencio (los archivos nuevos no aparecian ni en `git status`).
# Si tu editor ofrece "UTF-16 LE", no lo uses aqui.
# ==========================================================

# --- CREDENCIALES: NUNCA deben subir (este repo es publico) ---
.clasprc.json
.clasp.json
creds.json
client_secret_*.json
backend/sheet_token.json
real-estate-ocr-*.json
*-service-account*.json
service_account*.json

# Restos de depuracion de credenciales (contienen la llave privada).
# Nacieron como archivos temporales y quedaron olvidados en la raiz.
VALID_B64.txt
py_dec.json
test_dec.json
scratch_test_key.json
*_dec.json
*decoded*.json
*key*.json
*.key
*.pem

# --- Agente de Voz: variables de entorno locales (llaves reales para
#     probar con ngrok, ver agente_voz_implementacion.md FASE 3).
#     .env.example SI se sube -- son solo nombres, sin valores reales.
.env
.env.local
!.env.example

# --- Node ---
node_modules/

# --- Python (robot captador) ---
__pycache__/
*.pyc
*.pyo

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores ---
.vscode/
.idea/

# --- Temporales ---
temp_clasp/
*.tmp
*.docx
